# YamiBot Configuration
# Copy this file to .env and fill in your API keys

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# AI Provider API Keys (in fallback order)
# 1. Cerebras (Primary) - gpt-oss-120b
# Get from: https://cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# 2. SambaNova (Backup) - gpt-oss-120b
# Get from: https://sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# 3. Groq (Fallback) - openai/gpt-oss-120b
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 4. Mistral (Safety) - mistral-small-latest
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# 5. Google Gemini (Latest) - gemini-2.0-flash
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Gemini Model Selection (optional)
# Available models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GOOGLE_MODEL=gemini-2.0-flash

# Bot Configuration (optional)
BOT_PREFIX=!
SYNC_COMMANDS=false
DEBUG_MODE=false

# Conversation Settings
# Maximum number of messages to keep in conversation history
MAX_CONVERSATION_HISTORY=10

# Time in seconds before conversation context expires (default: 1 hour)
CONVERSATION_TIMEOUT=3600

# Permission & Security Settings
# Comma-separated Discord user IDs for different access levels
ADMIN_USER_IDS=                     # Admin users (full access)
TRUSTED_USER_IDS=                   # Trusted users (higher rate limits)
WHITELIST_USER_IDS=                 # If set, only these users can use bot (leave empty to allow all)
BLACKLIST_USER_IDS=                 # Banned users (comma-separated)

# User Rate Limiting
# Per-user rate limits to prevent abuse
MAX_REQUESTS_PER_MINUTE=5           # Max requests per minute per user
MAX_REQUESTS_PER_HOUR=30            # Max requests per hour per user
COOLDOWN_SECONDS=5                  # Cooldown after hitting rate limit
TRUSTED_USER_MULTIPLIER=2           # Multiplier for trusted users' limits

# Input Validation
# Message length constraints (Discord has 2000 char limit)
MAX_MESSAGE_LENGTH=2000             # Maximum message length
MIN_MESSAGE_LENGTH=1                # Minimum message length
MAX_RESPONSE_LENGTH=2000            # Maximum response length

# Music API Keys (Optional)
# Music features require these API keys to function

# Genius API (for lyrics and artist info)
# Get from: https://genius.com/api-clients (create free account)
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# SoundCloud API (for audio embedding and playback)
# Get from: https://soundcloud.com/you/apps (create app)
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here
