# YamiBot Configuration
# Copy this file to .env and fill in your API keys

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# AI Provider API Keys (in fallback order)
# 1. Cerebras (Primary) - gpt-oss-120b
# Get from: https://cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# 2. SambaNova (Backup) - gpt-oss-120b
# Get from: https://sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# 3. Groq (Fallback) - openai/gpt-oss-120b
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 4. Mistral (Safety) - mistral-small-latest
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Bot Configuration (optional)
BOT_PREFIX=!
SYNC_COMMANDS=false
DEBUG_MODE=false

# Conversation Settings
# Maximum number of messages to keep in conversation history
MAX_CONVERSATION_HISTORY=10

# Time in seconds before conversation context expires (default: 1 hour)
CONVERSATION_TIMEOUT=3600
